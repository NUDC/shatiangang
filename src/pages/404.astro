---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { NAV } from '@/data/site';
import { href } from '@/lib/url';
---

<Base
  title="页面不存在"
  description="你访问的页面不存在，可能是链接已变更或输入有误。"
  path="/404/"
  noindex
>
  <section class="wrap section" style="max-width:var(--measure)">
    <p class="section-head__kicker">404</p>
    <h1>这条航道不通</h1>
    <p class="muted mt-4">
      你访问的页面不存在。可能是链接已变更、输入有误，或者本站尚未建立这个实体页。
    </p>

    <div class="entity-graph mt-5">
      <p class="entity-graph__title">试试这些入口</p>
      <ul>
        <li><a class="tag tag--accent" href={href("/")}><Icon name="anchor" size="0.85em" />首页</a></li>
        {NAV.map((n) => <li><a class="tag" href={href(n.href)}>{n.label}</a></li>)}
      </ul>
    </div>

    <p class="small subtle mt-4">
      如果你是从站外链接过来的，说明本站可能有死链 ——
      欢迎<a href={href("/contribute/")}>告诉我们</a>，死链率是本站的月度巡检指标之一。
    </p>
  </section>
</Base>
