---
/**
 * 全站 <head>
 *
 * SEO / AEO / GEO 的地基都在这里：
 *  - canonical 绝对 URL（实体消歧 §3.2「一个实体只有一个 canonical URL」的技术落点）
 *  - OG / Twitter 卡片（社交与部分 AI 抓取器读这个）
 *  - JSON-LD @graph（GEO 核心）
 *  - 明确的 dateModified 与作者信号（E-E-A-T）
 */
import { SITE } from '@/data/site';
import { absUrl } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  path: string;
  /** JSON-LD @graph 序列化字符串，由 src/lib/schema.ts 的 graph() 生成 */
  jsonLd?: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  keywords?: string[];
  /** 待核实内容页不进索引，避免未核实事实被引擎固化 */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  jsonLd,
  ogType = 'website',
  // 上线前请把 og-default.svg 导出为 1200×630 PNG 并改这里：
  // 微信、X 等平台不渲染 SVG 格式的 OG 图。
  image = '/og-default.svg',
  imageAlt = '沙田港 · 广西北海合浦县沙田镇',
  publishedAt,
  updatedAt,
  author = SITE.author.name,
  keywords = [],
  noindex = false,
} = Astro.props;

// 全部经由 absUrl：挂载前缀只在 lib/url.ts 加一次
const canonical = absUrl(path, SITE.url);
const ogImage = absUrl(image, SITE.url);
/** 首页 title 已是完整句，内页才拼站点名 */
const fullTitle = path === '/' ? title : `${title} | ${SITE.shortName}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{keywords.length > 0 && <meta name="keywords" content={keywords.join('，')} />}
<meta name="author" content={author} />
<meta name="generator" content={Astro.generator} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  )
}

<!-- 语言与地域信号：帮助引擎判定内容归属地 -->
<meta http-equiv="content-language" content="zh-CN" />
<link rel="alternate" hreflang="zh-Hans" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta name="geo.region" content="CN-45" />
<meta name="geo.placename" content="广西壮族自治区北海市合浦县沙田镇" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
{ogType === 'article' && <meta property="article:author" content={author} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 供 AI 抓取器发现的机器可读入口 -->
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} 更新`} href={absUrl('/rss.xml', SITE.url)} />
<link rel="alternate" type="application/json" title="沙田港实体数据集" href={absUrl('/entities.json', SITE.url)} />
<link rel="sitemap" type="application/xml" href={absUrl('/sitemap-index.xml', SITE.url)} />

<link rel="icon" href={absUrl('/favicon.svg', SITE.url)} type="image/svg+xml" />
{/* 上线前补一张 180×180 的 apple-touch-icon.png，再放开下面这行 */}
{/* <link rel="apple-touch-icon" href={absUrl('/apple-touch-icon.png', SITE.url)} /> */}
<meta name="theme-color" content="#1c5f88" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#07131c" media="(prefers-color-scheme: dark)" />

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
